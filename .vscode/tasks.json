{
  "version": "2.0.0",
  "inputs": [
    {
      "id": "flavor",
      "type": "pickString",
      "description": "Select build flavor",
      "options": ["dev", "staging", "prod"],
      "default": "dev"
    }
  ],
  "tasks": [
    {
      "label": "Flutter Clean",
      "type": "shell",
      "command": "fvm flutter clean",
      "problemMatcher": []
    },
    {
      "label": "Flutter Get",
      "type": "shell",
      "command": "fvm flutter pub get",
      "problemMatcher": []
    },
    {
      "label": "Build Runner - Freezed",
      "type": "shell",
      "command": "fvm flutter pub run build_runner build --delete-conflicting-outputs",
      "problemMatcher": []
    },
    {
      "label": "Build Runner - Riverpod",
      "type": "shell",
      "command": "dart run build_runner watch -d",
      "problemMatcher": []
    },
    {
      "label": "Generate Splash",
      "type": "shell",
      "command": "fvm flutter pub run flutter_native_splash:create",
      "problemMatcher": []
    },
    {
      "label": "Generate Icons",
      "type": "shell",
      "command": "fvm flutter pub run flutter_launcher_icons",
      "problemMatcher": []
    },
    {
      "label": "Format Code",
      "type": "shell",
      "command": "dart format --set-exit-if-changed .",
      "problemMatcher": []
    },
    {
      "label": "Analyze Code",
      "type": "shell",
      "command": "dart analyze --fatal-infos --fatal-warnings .",
      "problemMatcher": []
    },
    {
      "label": "📦 Build APK",
      "type": "shell",
      "command": "fvm flutter build apk --dart-define-from-file=config.${input:flavor}.json",
      "group": "build",
      "problemMatcher": ["$dart-build_runner"],
      "detail": "Build APK for selected flavor"
    }
  ]
}
