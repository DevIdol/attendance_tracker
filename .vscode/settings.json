{
  "java.compile.nullAnalysis.mode": "automatic",
  "editor.defaultFormatter": "Dart-Code.dart-code",
  "editor.formatOnSave": true,
  "editor.formatOnPaste": true,
  "editor.guides.bracketPairs": true,
  "editor.bracketPairColorization.enabled": false,
  "editor.smoothScrolling": true,
  "editor.codeActionsOnSave": {
    "source.fixAll": "explicit",
    "source.organizeImports": "explicit"
  },
  "dart.previewFlutterUiGuides": false,
  "dart.previewFlutterUiGuidesCustomTracking": true,
  "dart.closingLabels": false,
  "dart.hotReloadOnSave": "manual",
  "files.autoSave": "onFocusChange",
  "explorer.fileNesting.enabled": true,
  "explorer.fileNesting.expand": false,
  "explorer.fileNesting.patterns": {
    "pubspec.yaml": ".flutter-plugins, .dart_tool, .metadata, pubspec.lock, analysis_options.yaml, .flutter-plugins-dependencies",
    "readme.*": "readme*",
    "*.dart": "$(capture).g.dart, $(capture).freezed.dart, $(capture).test.dart",
    "firebase.json": "firebase.rules, firebase.indexes.json"
  },
  "[json]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "[jsonc]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "[yaml]": { "editor.defaultFormatter": "redhat.vscode-yaml" },
  "dart.flutterSdkPath": ".fvm/versions/3.24.5",
  "[github-actions-workflow]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[markdown]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "dart.lineLength": 80,
  "editor.rulers": [80],
  "dart.renameFilesWithClasses": "prompt",
  "files.exclude": {
    "**/*.g.dart": false,
    "**/*.freezed.dart": false,
    "**/*.gr.dart": false,
    "**/build": true
  },
  "editor.tabSize": 2,
  "editor.detectIndentation": false,
  "dart.debugExternalPackageLibraries": false,
  "dart.debugSdkLibraries": false,
  "window.zoomLevel": 0,
  "terminal.integrated.defaultProfile.windows": "Git Bash",
  "terminal.integrated.defaultProfile.linux": "bash",
  "terminal.integrated.defaultProfile.osx": "bash",
  "[dart]": {
    "editor.defaultFormatter": "Dart-Code.dart-code",
    "editor.codeLens": true,
    "editor.formatOnSave": true,
    "editor.formatOnType": true,
    "editor.rulers": [80],
    "editor.suggestOnTriggerCharacters": true,
    "editor.tabSize": 2
  },
  "dart.cliAdditionalArgs": ["format", "--line-length", "80"],
  "java.configuration.updateBuildConfiguration": "interactive"
}
